# ---- LLM (Gemini) ----
GEMINI_API_KEY=your_key_here
# "gemini-flash-latest" always points to the newest Flash model.
# To pin a fixed version, put its exact name here (see https://ai.google.dev/gemini-api/docs/models).
GEMINI_MODEL=gemini-3-flash-preview
# If your key says the model is not found, run: python scripts/list_models.py
# (the app also tries to pick a working Flash model by itself)

# ---- PostgreSQL ----
DB_HOST=127.0.0.1
DB_PORT=5433
DB_NAME=insightflow
DB_USER=insightflow_admin
DB_PASSWORD=admin_dev_password

# Read-only user used ONLY for AI-generated queries (created by db/init.sql)
DB_READONLY_USER=insightflow_readonly
DB_READONLY_PASSWORD=readonly_dev_password

# ---- Limits ----
MAX_UPLOAD_MB=50
MAX_UPLOAD_ROWS=500000
MAX_UPLOAD_COLUMNS=200
QUERY_TIMEOUT_SECONDS=10
MAX_RESULT_ROWS=1000

# ---- Frontend ----
API_BASE_URL=http://127.0.0.1:8000
